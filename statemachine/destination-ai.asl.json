{
  "Comment": "A description of my state machine",
  "StartAt": "Get Prompt for OpenAI",
  "States": {
    "Get Prompt for OpenAI": {
      "Type": "Task",
      "Arguments": {
        "Bucket": "${DataBucketName}",
        "Key": "prompts/destination-prompt.txt"
      },
      "Resource": "arn:aws:states:::aws-sdk:s3:getObject",
      "Next": "Call OpenAI for autocomplete destination",
      "Assign": {
        "openAIPrompt": "{% $states.result.Body %}",
        "destination": "{% $states.input.destination %}"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "BackoffRate": 2,
          "IntervalSeconds": 1,
          "MaxAttempts": 3
        }
      ]
    },
    "Call OpenAI for autocomplete destination": {
      "Type": "Task",
      "Resource": "arn:aws:states:::http:invoke",
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "BackoffRate": 2,
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "JitterStrategy": "FULL",
          "Comment": "If any error"
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Comment": "If there is any error that is not solvable",
          "Output": {
            "message": "No se pudo generar el destino. Reintentar mas tarde."
          },
          "Next": "Fail"
        }
      ],
      "Assign": {
        "destinationData": "{% $states.result.ResponseBody.choices[0].message.content %}"
      },
      "Arguments": {
        "ApiEndpoint": "https://api.openai.com/v1/chat/completions",
        "Method": "POST",
        "InvocationConfig": {
          "ConnectionArn": "${OpenAIConnectionArn}"
        },
        "RequestBody": {
          "model": "gpt-5.6-luna",
          "messages": [
            {
              "role": "user",
              "content": "{% $openAIPrompt & $destination %}"
            }
          ],
          "response_format": {
            "type": "json_object"
          }
        }
      },
      "End": true,
      "Output": "{% $states.result %}"
    },
    "Fail": {
      "Type": "Fail",
      "Cause": "{% $states.input.message %}",
      "Error": "DestinationGenerationFailed"
    }
  },
  "QueryLanguage": "JSONata"
}